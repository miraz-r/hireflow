# Server
PORT=5000
NODE_ENV=development

# Local Vite frontend origin
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/hireflow

# DNS resolver override (OPTIONAL). Only set when the host OS resolver is
# misconfigured and mongodb+srv:// lookups fail. Comma-separated servers.
# DNS_SERVERS=1.1.1.1,1.0.0.1

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Email (Resend) — used for email-change verification
# RESEND_API_KEY is optional: when unset, the server boots and email sending
# is skipped with a warning instead of failing.
RESEND_API_KEY=re_xxx
# Verified sender for outbound email (must be configured in Resend).
EMAIL_FROM=HireFlow <onboarding@resend.dev>

# Required in production (NODE_ENV=production): the exact public origin of the
# deployed frontend. CORS is locked to this single origin and email-change
# links are built from it.
# CLIENT_ORIGIN=https://hireflow.yourdomain.com
