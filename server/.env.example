# Server
PORT=5000
NODE_ENV=development

# Local Vite frontend origin
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/hireflow

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Email (Resend) — used for email-change verification
# RESEND_API_KEY is optional: when unset, the server boots and email sending
# is skipped with a warning instead of failing.
RESEND_API_KEY=re_xxx
# Verified sender for outbound email (must be configured in Resend).
EMAIL_FROM=HireFlow <onboarding@resend.dev>