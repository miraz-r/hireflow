# Frontend environment (Vite). Values prefixed with VITE_ are baked into the
# client bundle at build time — never put secrets in them.

# Base URL of the backend API. Required for production builds
# (npm run build). In local development, defaults to http://localhost:5000/api.
# VITE_API_BASE_URL=https://api.yourdomain.com/api

# Origin that serves uploaded files (avatars, resumes). Required for
# production builds. In local development, defaults to http://localhost:5000.
# VITE_MEDIA_BASE=https://api.yourdomain.com
